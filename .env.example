# ---- Supabase (auth + database) ----
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# ---- Groq LLM — server-side only ----
GROQ_API_KEY=your-groq-api-key
# Vision-capable model for meal photo analysis. Use a Meta Llama vision model if your
# Groq account has access (e.g. meta-llama/llama-4-scout-17b-16e-instruct); otherwise
# qwen/qwen3.6-27b works on all accounts.
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_TEXT_MODEL=qwen/qwen3.6-27b
